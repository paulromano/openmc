<?xml version='1.0' encoding='utf-8'?>
<model>
  <materials>
    <material id="1" depletable="true">
      <density value="18.0" units="g/cm3"/>
      <nuclide name="U235" ao="1.0"/>
    </material>
  </materials>
  <geometry>
    <cell id="1" material="1" region="-1" universe="1"/>
    <surface id="1" type="sphere" boundary="vacuum" coeffs="0.0 0.0 0.0 0.4"/>
  </geometry>
  <settings>
    <run_mode>fixed source</run_mode>
    <particles>10000</particles>
    <batches>10</batches>
    <source type="independent" strength="1.0" particle="neutron">
      <space type="point">
        <parameters>0.0 0.0 0.0</parameters>
      </space>
      <energy type="discrete">
        <parameters>10000.0 1.0</parameters>
      </energy>
    </source>
    <ptables>false</ptables>
    <survival_biasing>false</survival_biasing>
    <recoil_production>true</recoil_production>
    <cutoff>
      <energy_neutron>9990.0</energy_neutron>
    </cutoff>
    <temperature_multipole>false</temperature_multipole>
    <create_fission_neutrons>false</create_fission_neutrons>
  </settings>
  <tallies>
    <filter id="2" type="reaction">
      <bins>(n,gamma) (n,fission) (n,f) (n,nf) (n,2nf) (n,3nf)</bins>
    </filter>
    <filter id="1" type="particleproduction">
      <particles>U236</particles>
      <energies>0.0 10000000.0</energies>
    </filter>
    <tally id="1" name="rates">
      <nuclides>U235</nuclides>
      <scores>(n,gamma) absorption fission</scores>
    </tally>
    <tally id="2" name="production">
      <filters>2 1</filters>
      <scores>events</scores>
    </tally>
  </tallies>
</model>
